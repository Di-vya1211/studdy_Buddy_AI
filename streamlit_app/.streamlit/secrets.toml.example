# ─────────────────────────────────────────────────────────────────────────────
# StudyBuddy — Streamlit Cloud Secrets
# Copy the relevant lines into App Settings → Secrets on share.streamlit.io
# ─────────────────────────────────────────────────────────────────────────────

# ── LLM (pick one) ────────────────────────────────────────────────────────────
GROQ_API_KEY    = "gsk_..."           # FREE  → https://console.groq.com/keys
# OPENAI_API_KEY = "sk-..."           # Paid  → https://platform.openai.com/api-keys

# ── Auth (REQUIRED — change SECRET_KEY before deploying!) ────────────────────
SECRET_KEY            = "change-this-to-a-random-32-char-hex-string"
ADMIN_SEED_EMAIL      = "admin@studybuddy.com"
ADMIN_SEED_PASSWORD   = "Admin@StudyBuddy2024"

# ── Email / SMTP (optional — leave empty to disable email notifications) ──────
# SMTP_HOST = "smtp.gmail.com"
# SMTP_PORT = "587"
# SMTP_USER = "you@gmail.com"
# SMTP_PASS = "your-app-password"
# SMTP_FROM = "noreply@studybuddy.com"
