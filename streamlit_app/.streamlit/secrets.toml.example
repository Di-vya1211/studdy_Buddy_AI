# ── Copy this file to .streamlit/secrets.toml and fill in real values ──────────
# On Streamlit Cloud, add these as Secrets in the app dashboard instead.

# ── LLM provider ───────────────────────────────────────────────────────────────
GROQ_API_KEY      = "gsk_xxxxxxxxxxxxxxxxxxxxxxxxxxxx"
GROQ_MODEL        = "groq/compound-mini"
OPENAI_API_KEY    = ""   # optional — leave empty to use Groq only

# ── Auth ────────────────────────────────────────────────────────────────────────
# REQUIRED — must be a long, random string; never commit a real value
SECRET_KEY        = "CHANGE_ME_use_openssl_rand_hex_32"
AUTH_REQUIRED     = true    # set to false only for local dev / demo

# ── Admin seed account ─────────────────────────────────────────────────────────
ADMIN_SEED_EMAIL    = "admin@studybuddy.com"
ADMIN_SEED_PASSWORD = "Admin@StudyBuddy2024"   # change in production

# ── Email (optional SMTP — leave blank to disable) ────────────────────────────
SMTP_HOST = ""
SMTP_PORT = "587"
SMTP_USER = ""
SMTP_PASS = ""
SMTP_FROM = "noreply@studybuddy.com"
APP_BASE_URL = "https://studybuddy.streamlit.app"

# ── Database (default: SQLite for Streamlit Cloud) ─────────────────────────────
# For production, use a Postgres URL:
# DATABASE_URL = "postgresql+asyncpg://user:pass@host:5432/studybuddy"
# DATABASE_URL = "sqlite+aiosqlite:///./data/studybuddy.db"  # default — auto-set

# ── Notes ───────────────────────────────────────────────────────────────────────
# • Streamlit Cloud disk is ephemeral. Uploads and the SQLite DB will be lost on
#   every redeploy / dyno restart.
# • For persistent storage, provision a Postgres database and an S3-compatible
#   object store, then set DATABASE_URL and UPLOAD_DIR accordingly.
